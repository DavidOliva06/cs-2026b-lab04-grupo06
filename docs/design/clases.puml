@startuml
title HU-01: Enviar un reporte sin señal y sincronizarlo - Diagrama de clases

enum EstadoReporte {
  BORRADOR
  ENCOLADO
  RECIBIDO
  VERIFICADO
  ATENDIDO
  RECHAZADO
}

class Ciudadano {
  ' Supuesto: se identifica al ciudadano con un id para asociarle sus reportes.
  - id: UUID
  + puedeReportar(): Boolean
}

class Consentimiento {
  ' Si fechaAceptacion tiene valor, el consentimiento está aceptado.
  - fechaAceptacion: DateTime [0..1]
  + aceptar(fecha: DateTime): void
  + estaAceptado(): Boolean
}

class Reporte {
  ' Supuesto: el id se genera en el celular para que el servidor detecte reenvíos (criterio 3).
  ' BORRADOR y ENCOLADO ocurren en el celular; los demás estados, en el servidor.
  - id: UUID
  - fechaCreacion: DateTime
  - fechaRecepcion: DateTime [0..1]
  + estaEncolado(): Boolean
  + encolar(): void
  + marcarRecibido(fecha: DateTime): void
  ' Supuesto: verificar, rechazar y marcarAtendido salen del diagrama de estados, no de la HU-01.
  + verificar(): void
  + rechazar(): void
  + marcarAtendido(): void
}

class Foto {
  ' Supuesto: la foto se guarda como bytes junto con su tipo de archivo.
  - contenido: Byte[]
  - tipoMime: String
}

class Ubicacion {
  - latitud: Double
  - longitud: Double
}

' Agregadas por la regla C1 (consistencia.md): receptoras de mensajes del diagrama de secuencia.
class FormularioReporte <<UI de la PWA>> {
  + mostrarEstado(estado: EstadoReporte): void
  + mostrarConsentimiento(): void
}

class ControladorReportes {
  + enviarReporte(foto: Foto, ubicacion: Ubicacion): void
  + alRecuperarConexion(): void
}

' Agregadas por el round-trip (diferencia 1): adaptadores que implementan los puertos.
class AdaptadorAlmacenLocalReportes
class AdaptadorAlmacenServidorReportes
class AdaptadorEnvioReportes

' Lado del celular: crea el reporte, lo guarda y lo reenvía (criterios 1, 2 y 4).
class ServicioReportes {
  + crearReporte(ciudadano: Ciudadano, foto: Foto, ubicacion: Ubicacion): Reporte
  + sincronizarPendientes(): void
}

' Lado del servidor: recibe el reporte y descarta duplicados (criterio 3).
class ServicioIngesta {
  ' Devuelve true si el servidor tiene el reporte, sea nuevo o repetido.
  + recibir(reporte: Reporte): Boolean
}

' Puerto de almacenamiento en el celular.
interface AlmacenLocalReportes <<puerto>> {
  ' guardar crea el reporte o actualiza el existente.
  + guardar(reporte: Reporte): void
  + buscarPorEstado(estado: EstadoReporte): List<Reporte>
}

' Puerto de almacenamiento en el servidor.
interface AlmacenServidorReportes <<puerto>> {
  ' Operación atómica: devuelve true si lo guardó y false si ya existía.
  + guardarSiNoExiste(reporte: Reporte): Boolean
}

' Puerto de salida del celular hacia el servidor.
interface PuertoEnvioReportes <<puerto>> {
  ' Devuelve true si el servidor confirmó que tiene el reporte.
  + enviar(reporte: Reporte): Boolean
}

' Nombres de rol iguales a los atributos del código (round-trip, diferencia 7).
Ciudadano "1" *-- "1" Consentimiento : consentimiento
Ciudadano "1 ciudadano" -- "0..* reportes" Reporte : registra >
Reporte "1" *-- "1" Foto : foto
Reporte "1" *-- "1" Ubicacion : ubicacion
Reporte "0..*" --> "1" EstadoReporte : estado

FormularioReporte "1" -- "1" ControladorReportes
ControladorReportes "1" --> "1" ServicioReportes : servicio

ServicioReportes ..> Ciudadano : verifica consentimiento
ServicioReportes ..> Reporte : crea
ServicioReportes "1" --> "1" AlmacenLocalReportes : almacen_local
ServicioReportes "1" --> "1" PuertoEnvioReportes : puerto_envio
ServicioIngesta "1" --> "1" AlmacenServidorReportes : almacen_servidor
ServicioIngesta ..> Reporte : recibe

AdaptadorAlmacenLocalReportes ..|> AlmacenLocalReportes
AdaptadorAlmacenServidorReportes ..|> AlmacenServidorReportes
AdaptadorEnvioReportes ..|> PuertoEnvioReportes
@enduml