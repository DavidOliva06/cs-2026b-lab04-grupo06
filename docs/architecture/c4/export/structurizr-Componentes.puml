@startuml
title <size:24>SismoReporta AQP - Componentes de la API (nivel 3)</size>\n<size:24>Componentes del contenedor API, uno por paquete de paquetes.puml.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

AddElementTag("Component", $bgColor="#85bbf0", $borderColor="#5d82a8", $fontColor="#000000", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Database", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Web Browser", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#444444", $lineColor="#444444", $lineStyle = DashedLine())

AddBoundaryTag("Container", $bgColor="#ffffff", $borderColor="#2e6295", $fontColor="#2e6295", $shadowing="", $borderStyle="solid")

System_Boundary("SismoReportaAQP_boundary", "SismoReporta AQP", $tags="Software System") {
  Container_Boundary("SismoReportaAQP.API_boundary", "API", $tags="Container") {
    Component(SismoReportaAQP.API.Brigadas, "Brigadas", $techn="Python", $descr="Brigada, Asignacion y ServicioAsignacion; implementa ConsultaZonasAsignadas. No atiende ningún escenario del árbol de utilidad.", $tags="Component", $link="")
    Component(SismoReportaAQP.API.Mapa, "Mapa", $techn="Python", $descr="ServicioMapa: GET /api/mapa/zonas devuelve un registro por zona y GET /api/mapa/zonas/{zona}/reportes el detalle (ADR-007) [QA-R2].", $tags="Component", $link="")
    Component(SismoReportaAQP.API.Dispositivos, "Dispositivos", $techn="Python, HMAC-SHA256", $descr="Emite identificadores de dispositivo firmados, cuenta los reportes de cada dispositivo en 10 min, marca a los sospechosos y publica DispositivoSospechoso al operador con el Observer de ADR-005 (ADR-008) [QA-S2].", $tags="Component", $link="")
    Component(SismoReportaAQP.API.Compartido, "Compartido", $techn="Python", $descr="Tipos comunes Ubicacion y Zona, y el puerto ColaTrabajos: el reporte y su trabajo se guardan en una transacción [QA-D1].", $tags="Component", $link="")
    Component(SismoReportaAQP.API.Reportes, "Reportes", $techn="Python", $descr="Ingesta idempotente por identificador único (UUID) en ServicioIngesta, y puertos AlmacenServidorReportes y ConsultaReportes [QA-D1]. En modo pico acepta solo los datos y difiere la foto (ADR-006) [QA-D1]; responde 429 al reporte n.º 11 de un dispositivo en 10 min (ADR-008) [QA-S2].", $tags="Component", $link="")
    Component(SismoReportaAQP.API.Priorización, "Priorización", $techn="Python", $descr="Calcula ZonaPriorizada y define el puerto ConsultaZonasAsignadas (decisión de arquitectura ADR-004). Cuenta un voto por dispositivo y zona y excluye a los sospechosos (ADR-008) [QA-S2].", $tags="Component", $link="")
  }

  ContainerDb(SismoReportaAQP.Basededatos, "Base de datos", $techn="PostgreSQL", $descr="Reportes, usuarios, consentimientos, zonas, asignaciones y la tabla de trabajos [QA-D1]. Índices por zona y región para el mapa [QA-R2]; dispositivo_id en cada reporte y tabla de dispositivos [QA-S2].", $tags="Container,Database", $link="")
  ContainerDb(SismoReportaAQP.Almacenamientodefotos, "Almacenamiento de fotos", $techn="Sistema de archivos", $descr="Fotos de los reportes comprimidas y sin metadatos EXIF (fecha, cámara y coordenadas GPS), en un volumen separado [QA-D3]. En modo pico deja de crecer (ADR-006) [QA-D1].", $tags="Container,Database", $link="")
  Container(SismoReportaAQP.Aplicaciónwebprogresiva, "Aplicación web progresiva", $techn="JavaScript, CSS, Service Worker e IndexedDB", $descr="Interfaz de los tres roles. Guarda los reportes sin señal en una cola local y los reenvía al recuperar la conexión; en modo pico deja la foto para después (ADR-006) [QA-D1]. Envía el identificador de dispositivo firmado (ADR-008) [QA-S2]. El panel dibuja un marcador por zona (ADR-007) [QA-R2].", $tags="Container,Web Browser", $link="")
}

Rel(SismoReportaAQP.Aplicaciónwebprogresiva, SismoReportaAQP.API.Reportes, "Envía reportes de daños", $techn="HTTPS/JSON", $tags="Relationship", $link="")
Rel(SismoReportaAQP.Aplicaciónwebprogresiva, SismoReportaAQP.API.Mapa, "Pide el mapa de daños", $techn="HTTPS/JSON", $tags="Relationship", $link="")
Rel(SismoReportaAQP.Aplicaciónwebprogresiva, SismoReportaAQP.API.Brigadas, "Consulta y actualiza asignaciones", $techn="HTTPS/JSON", $tags="Relationship", $link="")
Rel(SismoReportaAQP.Aplicaciónwebprogresiva, SismoReportaAQP.API.Dispositivos, "Pide su identificador firmado; el panel lista los dispositivos sospechosos", $techn="HTTPS/JSON", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API.Mapa, SismoReportaAQP.API.Priorización, "Usa ZonaPriorizada", $techn="Llamada en proceso", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API.Mapa, SismoReportaAQP.API.Reportes, "Usa ConsultaReportes", $techn="Llamada en proceso", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API.Mapa, SismoReportaAQP.API.Compartido, "Usa Zona", $techn="Llamada en proceso", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API.Brigadas, SismoReportaAQP.API.Priorización, "Usa ZonaPriorizada e implementa ConsultaZonasAsignadas (decisión ADR-004)", $techn="Llamada en proceso", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API.Brigadas, SismoReportaAQP.API.Reportes, "Usa Reporte: verificar, rechazar, marcarAtendido", $techn="Llamada en proceso", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API.Brigadas, SismoReportaAQP.API.Compartido, "Usa Zona", $techn="Llamada en proceso", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API.Priorización, SismoReportaAQP.API.Reportes, "Usa ConsultaReportes", $techn="Llamada en proceso", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API.Priorización, SismoReportaAQP.API.Compartido, "Usa Zona y ColaTrabajos", $techn="Llamada en proceso", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API.Reportes, SismoReportaAQP.API.Compartido, "Usa Ubicacion y ColaTrabajos", $techn="Llamada en proceso", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API.Reportes, SismoReportaAQP.API.Dispositivos, "Verifica la firma y el límite por dispositivo", $techn="Llamada en proceso", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API.Priorización, SismoReportaAQP.API.Dispositivos, "Excluye los dispositivos sospechosos", $techn="Llamada en proceso", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API.Reportes, SismoReportaAQP.Basededatos, "Guarda el reporte y su trabajo en una transacción", $techn="SQL/TCP", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API.Reportes, SismoReportaAQP.Almacenamientodefotos, "Guarda la foto original", $techn="E/S de archivos", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API.Priorización, SismoReportaAQP.Basededatos, "Lee reportes por zona y las zonas priorizadas", $techn="SQL/TCP", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API.Brigadas, SismoReportaAQP.Basededatos, "Lee y escribe brigadas y asignaciones", $techn="SQL/TCP", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API.Mapa, SismoReportaAQP.Basededatos, "Lee reportes agrupados por zona con GROUP BY", $techn="SQL/TCP", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API.Dispositivos, SismoReportaAQP.Basededatos, "Guarda los dispositivos y cuenta sus reportes de los últimos 10 min", $techn="SQL/TCP", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API.Compartido, SismoReportaAQP.Basededatos, "Inserta trabajos en la tabla de trabajos (ColaTrabajos)", $techn="SQL/TCP", $tags="Relationship", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml