@startuml
title <size:24>SismoReporta AQP - Vista dinámica: sincronizar un reporte (HU-01)</size>\n<size:24>HU-01: enviar un reporte sin señal y sincronizarlo.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

AddElementTag("Component", $bgColor="#85bbf0", $borderColor="#5d82a8", $fontColor="#000000", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Database", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Person", $bgColor="#08427b", $borderColor="#052e56", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Web Browser", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#444444", $lineColor="#444444", $lineStyle = DashedLine())

AddBoundaryTag("Container", $bgColor="#ffffff", $borderColor="#2e6295", $fontColor="#2e6295", $shadowing="", $borderStyle="solid")

Person(Ciudadano, "Ciudadano", $descr="Reporta daños con foto y ubicación tras un sismo.", $tags="Person", $link="")

System_Boundary("SismoReportaAQP_boundary", "SismoReporta AQP", $tags="Software System") {
  Container_Boundary("SismoReportaAQP.API_boundary", "API", $tags="Container") {
    Component(SismoReportaAQP.API.Compartido, "Compartido", $techn="Python", $descr="Tipos comunes Ubicacion y Zona, y el puerto ColaTrabajos.", $tags="Component", $link="")
    Component(SismoReportaAQP.API.Reportes, "Reportes", $techn="Python", $descr="Ingesta idempotente por identificador único (UUID) en ServicioIngesta, y los puertos AlmacenServidorReportes y ConsultaReportes.", $tags="Component", $link="")
  }

  ContainerDb(SismoReportaAQP.Basededatos, "Base de datos", $techn="PostgreSQL", $descr="Reportes, usuarios, consentimientos, zonas, asignaciones y la tabla de trabajos.", $tags="Container,Database", $link="")
  ContainerDb(SismoReportaAQP.Almacenamientodefotos, "Almacenamiento de fotos", $techn="Sistema de archivos", $descr="Fotos de los reportes comprimidas y sin metadatos EXIF (fecha, cámara y coordenadas GPS), en un volumen separado.", $tags="Container,Database", $link="")
  Container(SismoReportaAQP.Aplicaciónwebprogresiva, "Aplicación web progresiva", $techn="JavaScript, CSS, Service Worker e IndexedDB", $descr="Interfaz de los tres roles. Guarda los reportes sin señal en una cola local y los reenvía al recuperar la conexión.", $tags="Container,Web Browser", $link="")
}

Person(Ciudadano, "Ciudadano", $descr="Reporta daños con foto y ubicación tras un sismo.", $tags="Person", $link="")
Container(SismoReportaAQP.Aplicaciónwebprogresiva, "Aplicación web progresiva", $techn="JavaScript, CSS, Service Worker e IndexedDB", $descr="Interfaz de los tres roles. Guarda los reportes sin señal en una cola local y los reenvía al recuperar la conexión.", $tags="Container,Web Browser", $link="")
ContainerDb(SismoReportaAQP.Basededatos, "Base de datos", $techn="PostgreSQL", $descr="Reportes, usuarios, consentimientos, zonas, asignaciones y la tabla de trabajos.", $tags="Container,Database", $link="")
ContainerDb(SismoReportaAQP.Almacenamientodefotos, "Almacenamiento de fotos", $techn="Sistema de archivos", $descr="Fotos de los reportes comprimidas y sin metadatos EXIF (fecha, cámara y coordenadas GPS), en un volumen separado.", $tags="Container,Database", $link="")

Rel(Ciudadano, SismoReportaAQP.Aplicaciónwebprogresiva, "1: Registra el reporte con foto y ubicación; sin señal queda en la cola local", $techn="HTTPS", $tags="Relationship", $link="")
Rel(SismoReportaAQP.Aplicaciónwebprogresiva, SismoReportaAQP.API.Reportes, "2: Al recuperar la señal, envía cada reporte pendiente con su identificador único (UUID)", $techn="HTTPS/JSON", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API.Reportes, SismoReportaAQP.Basededatos, "3: Guarda el reporte solo si su UUID no existe (guardarSiNoExiste)", $techn="SQL/TCP", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API.Reportes, SismoReportaAQP.Almacenamientodefotos, "4: Guarda la foto original", $techn="E/S de archivos", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API.Reportes, SismoReportaAQP.API.Compartido, "5: Encola el procesamiento de la foto mediante ColaTrabajos", $techn="Llamada en proceso", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API.Compartido, SismoReportaAQP.Basededatos, "6: Inserta el trabajo en la misma transacción que el reporte", $techn="SQL/TCP", $tags="Relationship", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml