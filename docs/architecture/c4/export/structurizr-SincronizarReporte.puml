@startuml
title <size:24>Dynamic View: SismoReporta AQP - API</size>\n<size:24>HU-01: enviar un reporte sin señal y sincronizarlo.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

Person(Ciudadano, "Ciudadano", $descr="Reporta daños con foto y ubicación tras un sismo.", $tags="", $link="")

System_Boundary("SismoReportaAQP_boundary", "SismoReporta AQP", $tags="") {
  Container_Boundary("SismoReportaAQP.API_boundary", "API", $tags="") {
    Component(SismoReportaAQP.API.Compartido, "Compartido", $techn="Python", $descr="Tipos comunes Ubicacion y Zona, y el puerto ColaTrabajos.", $tags="", $link="")
    Component(SismoReportaAQP.API.Reportes, "Reportes", $techn="Python", $descr="Ingesta idempotente por UUID (ServicioIngesta) y puertos AlmacenServidorReportes y ConsultaReportes.", $tags="", $link="")
  }

  ContainerDb(SismoReportaAQP.Basededatos, "Base de datos", $techn="PostgreSQL", $descr="Reportes, usuarios, consentimientos, zonas, asignaciones y la tabla de trabajos.", $tags="", $link="")
  ContainerDb(SismoReportaAQP.Almacenamientodefotos, "Almacenamiento de fotos", $techn="Sistema de archivos", $descr="Fotos de los reportes comprimidas y sin metadatos EXIF, en un volumen separado.", $tags="", $link="")
  Container(SismoReportaAQP.Aplicaciónwebprogresiva, "Aplicación web progresiva", $techn="JavaScript, CSS, Service Worker e IndexedDB", $descr="Interfaz de los tres roles. Guarda los reportes sin señal en una cola local y los reenvía al recuperar la conexión.", $tags="", $link="")
}

Person(Ciudadano, "Ciudadano", $descr="Reporta daños con foto y ubicación tras un sismo.", $tags="", $link="")
Container(SismoReportaAQP.Aplicaciónwebprogresiva, "Aplicación web progresiva", $techn="JavaScript, CSS, Service Worker e IndexedDB", $descr="Interfaz de los tres roles. Guarda los reportes sin señal en una cola local y los reenvía al recuperar la conexión.", $tags="", $link="")
ContainerDb(SismoReportaAQP.Basededatos, "Base de datos", $techn="PostgreSQL", $descr="Reportes, usuarios, consentimientos, zonas, asignaciones y la tabla de trabajos.", $tags="", $link="")
ContainerDb(SismoReportaAQP.Almacenamientodefotos, "Almacenamiento de fotos", $techn="Sistema de archivos", $descr="Fotos de los reportes comprimidas y sin metadatos EXIF, en un volumen separado.", $tags="", $link="")

Rel(Ciudadano, SismoReportaAQP.Aplicaciónwebprogresiva, "1: Registra el reporte con foto y ubicación; sin señal queda en la cola local", $techn="HTTPS", $tags="", $link="")
Rel(SismoReportaAQP.Aplicaciónwebprogresiva, SismoReportaAQP.API.Reportes, "2: Al recuperar la señal, envía cada reporte pendiente con su UUID", $techn="HTTPS/JSON", $tags="", $link="")
Rel(SismoReportaAQP.API.Reportes, SismoReportaAQP.Basededatos, "3: Guarda el reporte solo si su UUID no existe (guardarSiNoExiste)", $techn="SQL/TCP", $tags="", $link="")
Rel(SismoReportaAQP.API.Reportes, SismoReportaAQP.Almacenamientodefotos, "4: Guarda la foto original", $techn="E/S de archivos", $tags="", $link="")
Rel(SismoReportaAQP.API.Reportes, SismoReportaAQP.API.Compartido, "5: Encola el procesamiento de la foto mediante ColaTrabajos", $techn="Llamada en proceso", $tags="", $link="")
Rel(SismoReportaAQP.API.Compartido, SismoReportaAQP.Basededatos, "6: Inserta el trabajo en la misma transacción que el reporte", $techn="SQL/TCP", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml