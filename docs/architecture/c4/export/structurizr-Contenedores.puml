@startuml
title <size:24>SismoReporta AQP - Diagrama de contenedores (nivel 2)</size>\n<size:24>Diagrama de contenedores de SismoReporta AQP.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

AddElementTag("Software System,Externo", $bgColor="#999999", $borderColor="#6b6b6b", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Database", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Person", $bgColor="#08427b", $borderColor="#052e56", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Web Browser", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#444444", $lineColor="#444444", $lineStyle = DashedLine())

AddBoundaryTag("Software System", $bgColor="#ffffff", $borderColor="#0b4884", $fontColor="#0b4884", $shadowing="", $borderStyle="solid")

Person(Ciudadano, "Ciudadano", $descr="Reporta daños con foto y ubicación tras un sismo. Fuente de [QA-D1] y [QA-S1].", $tags="Person", $link="")
Person(Brigadista, "Brigadista", $descr="Atiende las zonas asignadas y actualiza su estado. No es fuente de ningún escenario del árbol de utilidad.", $tags="Person", $link="")
Person(Coordinador, "Coordinador", $descr="Revisa el mapa de daños, prioriza zonas y asigna brigadas. Fuente de [QA-R2]; revisa los dispositivos sospechosos [QA-S2].", $tags="Person", $link="")
System(Serviciodeteselasdemapa, "Servicio de teselas de mapa", $descr="Mapa base: OpenStreetMap o un proveedor de teselas. Externo: queda fuera de la medida de [QA-R2].", $tags="Software System,Externo", $link="")

System_Boundary("SismoReportaAQP_boundary", "SismoReporta AQP", $tags="Software System") {
  Container(SismoReportaAQP.Worker, "Worker", $techn="Python", $descr="Procesa fotos y recalcula la priorización de forma periódica. En modo pico solo recalcula la priorización y deja las fotos para después (ADR-006) [QA-D1].", $tags="Container", $link="")
  ContainerDb(SismoReportaAQP.Basededatos, "Base de datos", $techn="PostgreSQL", $descr="Reportes, usuarios, consentimientos, zonas, asignaciones y la tabla de trabajos [QA-D1]. Índices por zona y región para el mapa [QA-R2]; dispositivo_id en cada reporte y tabla de dispositivos [QA-S2].", $tags="Container,Database", $link="")
  ContainerDb(SismoReportaAQP.Almacenamientodefotos, "Almacenamiento de fotos", $techn="Sistema de archivos", $descr="Fotos de los reportes comprimidas y sin metadatos EXIF (fecha, cámara y coordenadas GPS), en un volumen separado [QA-D3]. En modo pico deja de crecer (ADR-006) [QA-D1].", $tags="Container,Database", $link="")
  Container(SismoReportaAQP.Aplicaciónwebprogresiva, "Aplicación web progresiva", $techn="JavaScript, CSS, Service Worker e IndexedDB", $descr="Interfaz de los tres roles. Guarda los reportes sin señal en una cola local y los reenvía al recuperar la conexión; en modo pico deja la foto para después (ADR-006) [QA-D1]. Envía el identificador de dispositivo firmado (ADR-008) [QA-S2]. El panel dibuja un marcador por zona (ADR-007) [QA-R2].", $tags="Container,Web Browser", $link="")
  Container(SismoReportaAQP.API, "API", $techn="Python", $descr="Monolito modular: ingesta idempotente con modo pico [QA-D1], mapa agregado por zona [QA-R2], control de roles [QA-S1], límite por dispositivo [QA-S2], priorización y brigadas.", $tags="Container", $link="")
}

Rel(Ciudadano, SismoReportaAQP.Aplicaciónwebprogresiva, "Envía reportes de daños con foto y ubicación", $techn="HTTPS", $tags="Relationship", $link="")
Rel(Brigadista, SismoReportaAQP.Aplicaciónwebprogresiva, "Consulta su asignación y marca su estado", $techn="HTTPS", $tags="Relationship", $link="")
Rel(Coordinador, SismoReportaAQP.Aplicaciónwebprogresiva, "Revisa el mapa y asigna brigadas", $techn="HTTPS", $tags="Relationship", $link="")
Rel(SismoReportaAQP.Aplicaciónwebprogresiva, SismoReportaAQP.API, "Envía reportes y consultas, a través del proxy inverso", $techn="HTTPS/JSON", $tags="Relationship", $link="")
Rel(SismoReportaAQP.Aplicaciónwebprogresiva, Serviciodeteselasdemapa, "Obtiene el mapa base", $techn="HTTPS/PNG", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API, SismoReportaAQP.Basededatos, "Lee y escribe datos", $techn="SQL/TCP", $tags="Relationship", $link="")
Rel(SismoReportaAQP.API, SismoReportaAQP.Almacenamientodefotos, "Guarda la foto original", $techn="E/S de archivos", $tags="Relationship", $link="")
Rel(SismoReportaAQP.Worker, SismoReportaAQP.Basededatos, "Toma trabajos con SKIP LOCKED (sin que dos procesos tomen el mismo) y guarda las zonas priorizadas", $techn="SQL/TCP", $tags="Relationship", $link="")
Rel(SismoReportaAQP.Worker, SismoReportaAQP.Almacenamientodefotos, "Redimensiona las fotos y elimina los metadatos EXIF (fecha, cámara y GPS)", $techn="E/S de archivos", $tags="Relationship", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml